{
  "name": "jupyter-monitor",
  "author": "lumine-code",
  "description": "Watch every running Jupyter kernel in one table.",
  "repository": "https://github.com/lumine-code/jupyter-monitor",
  "bugs": {
    "url": "https://github.com/lumine-code/jupyter-monitor/issues"
  },
  "homepage": "https://github.com/lumine-code/jupyter-monitor#readme",
  "keywords": [
    "kernel",
    "ipython",
    "session",
    "gateway",
    "interrupt",
    "restart"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "backgroundTips": [
    "You can see every running kernel, and interrupt or restart any of them, with {{ 'jupyter-monitor:toggle-focus' | keystroke }}"
  ],
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "activationCommands": {
    "lumine-workspace": [
      "jupyter-monitor:toggle-focus"
    ]
  },
  "consumedServices": {
    "jupyter.kernel": {
      "versions": {
        "^1.0.0": "consumeJupyterKernel"
      }
    }
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#ced81b11e336b839537fbe207d70b615cb89ad8a"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
