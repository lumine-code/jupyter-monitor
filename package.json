{
  "name": "jupyter-monitor",
  "author": "lumine-code",
  "description": "Watch every running Jupyter kernel in one table.",
  "repository": "https://github.com/lumine-code/jupyter-monitor",
  "bugs": {
    "url": "https://github.com/lumine-code/jupyter-monitor/issues"
  },
  "homepage": "https://github.com/lumine-code/jupyter-monitor#readme",
  "keywords": [
    "kernel",
    "ipython",
    "session",
    "gateway",
    "interrupt",
    "restart"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "main": "./lib/main",
  "specPackages": [
    "jupyter-repl"
  ],
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "deserializers": {
    "jupyter-monitor/MonitorPane": "deserializeMonitorPane"
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "jupyter.kernel": {
      "versions": {
        "^1.0.0": "consumeJupyterKernel"
      }
    }
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#096f2ad5cb3e7c2eca24df08670af77570abd4e7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.8"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.8"
    }
  }
}
