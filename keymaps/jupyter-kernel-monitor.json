{
  "atom-workspace": {
    "alt-h k": "jupyter-kernel-monitor:toggle"
  },

  "atom-workspace .kernel-monitor-wrapper": {
    "up": "jupyter-kernel-monitor:up",
    "down": "jupyter-kernel-monitor:down",
    "enter": "jupyter-kernel-monitor:open",
    "i": "jupyter-kernel-monitor:interrupt",
    "r": "jupyter-kernel-monitor:restart",
    "s": "jupyter-kernel-monitor:shutdown"
  }
}
