{
  "lumine-workspace": {
    "alt-j m": "jupyter-monitor:toggle-focus"
  },

  ".jupyter-monitor .monitor-wrapper": {
    "up": "core:move-up",
    "down": "core:move-down",
    "enter": "core:confirm",
    "escape": "core:cancel",
    "i": "jupyter-monitor:interrupt",
    "r": "jupyter-monitor:restart",
    "s": "jupyter-monitor:shutdown"
  }
}
